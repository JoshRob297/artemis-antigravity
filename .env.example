# ARTEMIS-Antigravity Configuration Template

# Daemon Port (avoid conflicts with other web services on 8000)
ARTEMIS_DAEMON_PORT=8005

# Target Android device serial (IP:port for wireless ADB, or USB serial)
# Example: ANDROID_SERIAL=192.168.1.100:5555 or ANDROID_SERIAL=emulator-5554
ANDROID_SERIAL=127.0.0.1:5555

# Multimodal LLM Provider (antigravity, google, openai, anthropic)
ARTEMIS_LLM_PROVIDER=antigravity

# Default Multimodal Model
ARTEMIS_DEFAULT_MODEL=gemini-3.8-flash

# Automatically install Artemis Accessibility Helper APK on first task
ARTEMIS_HELPER_AUTO_INSTALL=true

# Optional: Path to custom accounts.json file
# Defaults to ~/.config/antigravity/accounts.json or ~/.config/opencode/antigravity-accounts.json
# ANTIGRAVITY_ACCOUNTS_FILE=~/.config/antigravity/accounts.json
